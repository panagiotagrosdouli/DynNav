<?xml version="1.0"?>
<sdf version="1.8">
  <world name="default">
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <light name="sun" type="directional">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.8 0.8 0.8 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Outer 7 m x 5 m boundary; 0.15 m wall thickness matches 3 map cells. -->
    <model name="outer_walls">
      <static>true</static>
      <link name="walls">
        <collision name="south"><pose>3.5 0.075 0.5 0 0 0</pose><geometry><box><size>7.0 0.15 1.0</size></box></geometry></collision>
        <collision name="north"><pose>3.5 4.925 0.5 0 0 0</pose><geometry><box><size>7.0 0.15 1.0</size></box></geometry></collision>
        <collision name="west"><pose>0.075 2.5 0.5 0 0 0</pose><geometry><box><size>0.15 5.0 1.0</size></box></geometry></collision>
        <collision name="east"><pose>6.925 2.5 0.5 0 0 0</pose><geometry><box><size>0.15 5.0 1.0</size></box></geometry></collision>
        <visual name="south_v"><pose>3.5 0.075 0.5 0 0 0</pose><geometry><box><size>7.0 0.15 1.0</size></box></geometry></visual>
        <visual name="north_v"><pose>3.5 4.925 0.5 0 0 0</pose><geometry><box><size>7.0 0.15 1.0</size></box></geometry></visual>
        <visual name="west_v"><pose>0.075 2.5 0.5 0 0 0</pose><geometry><box><size>0.15 5.0 1.0</size></box></geometry></visual>
        <visual name="east_v"><pose>6.925 2.5 0.5 0 0 0</pose><geometry><box><size>0.15 5.0 1.0</size></box></geometry></visual>
      </link>
    </model>

    <!-- Central island: forces top and bottom parallel return corridors. -->
    <model name="central_island">
      <static>true</static>
      <pose>3.5 2.5 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>4.0 1.6 1.0</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>4.0 1.6 1.0</size></box></geometry>
          <material><ambient>0.35 0.35 0.35 1</ambient><diffuse>0.35 0.35 0.35 1</diffuse></material>
        </visual>
      </link>
    </model>

    <scene><shadows>false</shadows></scene>
    <physics name="3ms" type="ode"><max_step_size>0.003</max_step_size><real_time_factor>1</real_time_factor></physics>
  </world>
</sdf>
